# Server
PORT=5310
CLUSTER=mainnet
DB=/var/data/db.json            # persistent disk path
NC_RPC=                         # keyed Solana RPC, server side only, never sent to browsers
NC_TOKEN_MINT=                  # set after launch (pump.fun Token-2022 mint)
NC_TREASURY=
NC_HOLDER_MIN=100000            # Lab perk, feature submissions, X reply priority
NC_VOTE_MIN=1
NC_LAB_PER_DAY=5
ROUND_MINUTES=30
NP_PER_HOUR=150                 # total Neuronpedia steers per hour (X account + Lab)
NEURONPEDIA_API_KEY=            # optional

# X account (OAuth 1.0a user context of the brand account)
DRY_RUN=1                       # 1 = generate and preview on the site, never post
X_POSTING_ENABLED=0             # kill switch, must be 1 to post
X_DAILY_POST_CAP=60             # posts + replies per UTC day
X_REPLIES_PER_ROUND=4
X_MENTIONS_POLL_MIN=10
X_USER_ID=
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- creator-fee share (OFF by default) ----
NC_PAYOUT_ENABLED=0             # master switch
PAYOUT_DRY_RUN=1                # 1 = compute and record only, send nothing
NC_PAYOUT_KEY=                  # distributor wallet secret (base58 or JSON array). Server only, never logged
NC_PAYOUT_ADDRESS=              # optional: watch a distributor in dry run without its key
NC_PAYOUT_RPC=                  # defaults to NC_RPC
NC_PAYOUT_SHARE_BPS=7000        # winning voters, 70%
NC_NOMINATOR_BPS=1000           # nominator of the winning feature, 10% (rolls to voters if none)
NC_OPS_BPS=2000                 # operations, 20%
NC_OPS_ADDRESS=                 # required while NC_OPS_BPS > 0
NC_PAYOUT_MIN_LAMPORTS=1000000  # 0.001 SOL; smaller balances accrue
NC_PAYOUT_RESERVE_LAMPORTS=10000000
NC_PAYOUT_DAILY_CAP_LAMPORTS=2000000000
NC_PAYOUT_MAX_PER_TX=18

# ---- burns (OFF by default, USD-pegged, need a live price) ----
NC_NOMINATE_ENABLED=0
NC_NOMINATE_USD=5
NC_NOMINATE_MIN=10000
NC_NOMINATE_MAX_TOKENS=500000
NC_NOMINATE_MAX=6               # nominations per ballot
NC_REPLY_BURN_ENABLED=0
NC_REPLY_USD=1.5
NC_REPLY_MIN=3000
NC_REPLY_MAX_TOKENS=150000
NC_REPLY_PER_WALLET_DAY=3
PRICE_TTL_SEC=180
NC_QUOTE_SECRET=                # HMAC key for burn quotes; random per boot if empty
NC_QUOTE_TTL_SEC=300
