{
  "name": "neurocracy",
  "version": "0.1.0",
  "description": "An open AI model whose neurons are steered by its holders. Vote every 30 minutes, watch the model change, follow the account it runs.",
  "main": "server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "node scripts/build.js && node scripts/zk-fetch.js",
    "start": "node server.js",
    "test": "node --test test/",
    "presets": "node scripts/gen-presets.js",
    "shots": "node scripts/shots.js",
    "record": "python3 scripts/record.py docs/landing-scroll.mp4",
    "zk:verify": "node scripts/zk-verify.js"
  },
  "keywords": [
    "solana",
    "interpretability",
    "sparse-autoencoder",
    "steering",
    "gemma-scope",
    "neuronpedia"
  ],
  "author": "Neurocracy",
  "license": "MIT",
  "dependencies": {
    "@pump-fun/pump-sdk": "4.2.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "circomlibjs": "^0.1.7",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "lenis": "^1.3.27",
    "snarkjs": "^0.7.6",
    "three": "^0.186.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@solana/spl-token": "^0.4.15",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.43.1"
  },
  "homepage": "https://neurocracy.fun",
  "engines": {
    "node": ">=20"
  }
}
